#pragma kernel ReSTIRGIDenoiseTemporal DENOISE_TEMPORAL=ReSTIRGIDenoiseTemporal
#pragma kernel ReSTIRGIDenoiseTemporalFinal DENOISE_TEMPORAL=ReSTIRGIDenoiseTemporalFinal FINAL_PASS
#pragma kernel ReSTIRGIDenoiseSpatialStep1 DENOISE_SPATIAL=ReSTIRGIDenoiseSpatialStep1 GI_SPATIAL_STEP_SIZE=1
#pragma kernel ReSTIRGIDenoiseSpatialStep2 DENOISE_SPATIAL=ReSTIRGIDenoiseSpatialStep2 GI_SPATIAL_STEP_SIZE=2

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.danbaidong/ShaderLibrary/Core.hlsl"
#include "Packages/com.unity.render-pipelines.danbaidong/ShaderLibrary/DeclareDepthTexture.hlsl"
#include "Packages/com.unity.render-pipelines.danbaidong/ShaderLibrary/UnityGBuffer.hlsl"
#include "Packages/com.unity.render-pipelines.danbaidong/Shaders/ScreenSpaceLighting/ScreenSpaceLighting.hlsl"
#include "Packages/com.unity.render-pipelines.danbaidong/Runtime/ScreenSpaceLighting/ShaderVariablesScreenSpaceGlobalIllumination.cs.hlsl"
#include "Packages/com.unity.render-pipelines.danbaidong/Shaders/ScreenSpaceLighting/ReSTIRGICoordinates.hlsl"

TEXTURE2D_X(_GBuffer2);
TEXTURE2D_X(_PrevCameraDepthTexture);

TEXTURE2D_X(_InputGITexture);
TEXTURE2D_X(_PrevDenoisedGITexture);
TEXTURE2D_X(_InputMomentsTexture);
TEXTURE2D_X(_PrevMomentsTexture);

RW_TEXTURE2D(float4, _OutputGITextureRW);
RW_TEXTURE2D(float4, _OutputFinalGITextureRW);
RW_TEXTURE2D(float4, _OutputMomentsTextureRW);

float _GITemporalAccumulation;
int _GIDenoiseHistoryValid;
float4x4 _ClipToPrevClipMatrix;

bool IsValidPixel(uint2 coordSS)
{
    return all(coordSS < (uint2)_SSGITraceScreenSize.xy);
}

float3 LoadNormalWS(uint2 traceCoord)
{
    float4 gbuffer2 = LOAD_TEXTURE2D_X(_GBuffer2, GetReSTIRGISourceCoord(traceCoord));
    return normalize(UnpackNormal(gbuffer2.xyz));
}

#define GI_TEMPORAL_HALO_WIDTH (1)
#define GI_TEMPORAL_SHARED_WIDTH (8 + 2 * GI_TEMPORAL_HALO_WIDTH)

groupshared float4 temporalSharedColor[GI_TEMPORAL_SHARED_WIDTH * GI_TEMPORAL_SHARED_WIDTH];
groupshared float4 temporalSharedNormalDepth[GI_TEMPORAL_SHARED_WIDTH * GI_TEMPORAL_SHARED_WIDTH];

struct TemporalCoordDataGI
{
    float3 color;
    float3 normal;
    float depth;
    float valid;
};

TemporalCoordDataGI LoadFromTemporalGroupSharedMemory(uint2 coordGroup)
{
    uint idx = coordGroup.x + coordGroup.y * GI_TEMPORAL_SHARED_WIDTH;
    TemporalCoordDataGI c = (TemporalCoordDataGI)0;
    float4 gi = temporalSharedColor[idx];
    c.color = gi.rgb;
    c.valid = gi.a;
    float4 nd = temporalSharedNormalDepth[idx];
    c.normal = nd.xyz;
    c.depth = nd.w;
    return c;
}

void StoreInTemporalGroupSharedMemory(uint2 coordGroup, TemporalCoordDataGI inData)
{
    uint idx = coordGroup.x + coordGroup.y * GI_TEMPORAL_SHARED_WIDTH;
    temporalSharedColor[idx] = float4(inData.color, inData.valid);
    temporalSharedNormalDepth[idx] = float4(inData.normal, inData.depth);
}

void InitializeGroupSharedMemory_GI(int2 coordSS, int2 coordGroup)
{
    int2 tileOrigin = coordSS - coordGroup - GI_TEMPORAL_HALO_WIDTH;
    uint localIndex = (uint)(coordGroup.x + coordGroup.y * 8);
    // An 8x8 output tile only needs a one-pixel halo for its 3x3 statistics.
    for (uint tileIndex = localIndex; tileIndex < GI_TEMPORAL_SHARED_WIDTH * GI_TEMPORAL_SHARED_WIDTH; tileIndex += 64u)
    {
        uint2 tileCoord = uint2(tileIndex % GI_TEMPORAL_SHARED_WIDTH, tileIndex / GI_TEMPORAL_SHARED_WIDTH);
        int2 offsetCoordSS = tileOrigin + (int2)tileCoord;
        offsetCoordSS = clamp(offsetCoordSS, 0, _SSGITraceScreenSize.xy - 1);

        TemporalCoordDataGI coordData;
        float4 gi = LOAD_TEXTURE2D_X(_InputGITexture, offsetCoordSS);
        coordData.color = gi.rgb;
        coordData.valid = gi.a;
        coordData.normal = LoadNormalWS(offsetCoordSS);
        coordData.depth = LoadSceneDepth(GetReSTIRGISourceCoord((uint2)offsetCoordSS));
        StoreInTemporalGroupSharedMemory(tileCoord, coordData);
    }
}

struct FNeighborStatistics_GI
{
    float3 mean;
    float3 variance;
    float3 stdDev;
    float3 minVal;
    float3 maxVal;
    int count;
};

static const int2 kOffsets3x3_GI[8] =
{
    int2(-1, -1), int2( 1, -1), int2(-1,  1), int2( 1,  1),
    int2( 0, -1), int2(-1,  0), int2( 1,  0), int2( 0,  1),
};

bool IsCompatibleTemporalNeighbor(TemporalCoordDataGI center, TemporalCoordDataGI neighbor,
    float centerDepth)
{
    if (neighbor.valid <= 0.0 || neighbor.depth == UNITY_RAW_FAR_CLIP_VALUE)
        return false;
    if (dot(center.normal, neighbor.normal) < _SSGINormalTolerance)
        return false;

    float neighborDepth = LinearEyeDepth(neighbor.depth, _ZBufferParams);
    return abs(centerDepth - neighborDepth)
        <= max(_SSGIDepthTolerance * max(centerDepth, 1.0), 1e-4);
}

FNeighborStatistics_GI GetNeighborStatistics_GI(uint2 coordGroup, uint2 minCoord, uint2 maxCoord, TemporalCoordDataGI center)
{
    FNeighborStatistics_GI result = (FNeighborStatistics_GI)0;
    int count = center.valid > 0.0 ? 1 : 0;
    float3 M1 = count > 0 ? center.color : 0.0;
    float3 M2 = (float3)0;
    result.minVal = count > 0 ? center.color : float3(FLT_MAX, FLT_MAX, FLT_MAX);
    result.maxVal = count > 0 ? center.color : float3(-FLT_MAX, -FLT_MAX, -FLT_MAX);
    float centerDepth = LinearEyeDepth(center.depth, _ZBufferParams);

    for (uint neighborId = 0; neighborId < 8; neighborId++)
    {
        int2 offset = kOffsets3x3_GI[neighborId];
        int2 neighCoordGroupI = clamp(int2(coordGroup) + offset, int2(minCoord), int2(maxCoord));
        uint2 neighCoordGroup = (uint2)neighCoordGroupI;
        TemporalCoordDataGI neighData = LoadFromTemporalGroupSharedMemory(neighCoordGroup);
        if (!IsCompatibleTemporalNeighbor(center, neighData, centerDepth))
            continue;

        result.minVal = min(result.minVal, neighData.color);
        result.maxVal = max(result.maxVal, neighData.color);

        // Welford online variance to match SSR temporal neighborhood logic.
        count += 1;
        float3 delta1 = neighData.color - M1;
        M1 += delta1 / count;
        float3 delta2 = neighData.color - M1;
        M2 += delta1 * delta2;
    }

    result.count = count;
    result.mean = count > 0 ? M1 : 0.0;
    result.variance = count > 1 ? max(M2 / (count - 1), 0.0) : 0.0;
    result.stdDev = sqrt(result.variance);
    return result;
}

bool LoadReSTIRGIHistory(float2 screenUV, float2 prevScreenUV, float deviceDepth,
    float3 normalWS, out float3 color, out float4 moments)
{
    color = 0.0;
    moments = 0.0;
    if (!all(prevScreenUV > 0.0) || !all(prevScreenUV < 1.0))
        return false;

    float4 currentClip = ComputeClipSpacePosition(screenUV, deviceDepth);
    float4 previousClip = mul(_ClipToPrevClipMatrix, currentClip);
    if (previousClip.w <= 0.0)
        return false;

    float previousProjectedDeviceDepth = previousClip.z / previousClip.w;
    if (previousProjectedDeviceDepth < 0.0 || previousProjectedDeviceDepth > 1.0)
        return false;
    float expectedPreviousDepth = LinearEyeDepth(previousProjectedDeviceDepth, _ZBufferParams);
    float3 positionWS = ComputeWorldSpacePosition(screenUV, deviceDepth, UNITY_MATRIX_I_VP);
    float3 viewDirWS = GetWorldSpaceNormalizeViewDir(positionWS);
    float zAlignment = pow(saturate(1.0 - dot(normalWS, viewDirWS)), 8.0);
    float depthTolerance = lerp(5e-2, 1e-1, zAlignment);

    float2 tracePosition = GetReSTIRGITracePosition(prevScreenUV);
    int2 baseCoord = (int2)floor(tracePosition);
    float2 fraction = frac(tracePosition);
    int2 traceBoundary = (int2)_SSGITraceScreenSize.xy - 1;
    float weightSum = 0.0;

    [unroll]
    for (int y = 0; y < 2; ++y)
    {
        [unroll]
        for (int x = 0; x < 2; ++x)
        {
            int2 tapCoord = baseCoord + int2(x, y);
            if (any(tapCoord < 0) || any(tapCoord > traceBoundary))
                continue;

            float weight = (x == 0 ? 1.0 - fraction.x : fraction.x)
                * (y == 0 ? 1.0 - fraction.y : fraction.y);
            // Exact receiver reprojection can land a tiny fraction off an
            // integer texel after float math. Avoid three negligible tap reads.
            if (weight <= 1e-3)
                continue;

            float4 historyGI = LOAD_TEXTURE2D_X(_PrevDenoisedGITexture, tapCoord);
            if (historyGI.a <= 0.0)
                continue;

            uint2 previousSourceCoord = GetReSTIRGISourceCoord((uint2)tapCoord);
            float previousRawDepth = LOAD_TEXTURE2D_X(_PrevCameraDepthTexture, previousSourceCoord).r;
            if (previousRawDepth == UNITY_RAW_FAR_CLIP_VALUE)
                continue;

            float previousDepth = LinearEyeDepth(previousRawDepth, _ZBufferParams);
            if (abs(previousDepth - expectedPreviousDepth)
                > depthTolerance * max(expectedPreviousDepth, 1e-5))
                continue;

            color += historyGI.rgb * weight;
            moments += LOAD_TEXTURE2D_X(_PrevMomentsTexture, tapCoord) * weight;
            weightSum += weight;
        }
    }

    if (weightSum <= 1e-5)
        return false;

    color /= weightSum;
    moments /= weightSum;
    return true;
}

[numthreads(8, 8, 1)]
void DENOISE_TEMPORAL(uint3 dispatchThreadID : SV_DispatchThreadID, uint2 groupThreadID : SV_GroupThreadID)
{
    uint2 coordSS = dispatchThreadID.xy;
    bool validPixel = IsValidPixel(coordSS);
    uint2 coordGroup = groupThreadID.xy;

    InitializeGroupSharedMemory_GI(int2(coordSS), int2(coordGroup));
    GroupMemoryBarrierWithGroupSync();
    coordGroup += GI_TEMPORAL_HALO_WIDTH;

    TemporalCoordDataGI curCoordData = LoadFromTemporalGroupSharedMemory(coordGroup);
    if (!validPixel || curCoordData.depth == UNITY_RAW_FAR_CLIP_VALUE)
    {
        if (validPixel)
        {
            _OutputGITextureRW[coordSS] = 0.0;
            #if FINAL_PASS
            _OutputFinalGITextureRW[coordSS] = 0.0;
            #endif
            _OutputMomentsTextureRW[coordSS] = 0.0;
        }
        return;
    }

    FNeighborStatistics_GI localNeighborhood = GetNeighborStatistics_GI(coordGroup,
        uint2(0, 0), uint2(GI_TEMPORAL_SHARED_WIDTH - 1, GI_TEMPORAL_SHARED_WIDTH - 1), curCoordData);
    bool currentValid = curCoordData.valid > 0.0;
    float3 currentData = curCoordData.color;

    uint2 sourceCoord = GetReSTIRGISourceCoord(coordSS);
    float2 motionVector = LoadMotionVectorOffset(sourceCoord);
    float2 screenUV = TransformCoordSSToScreenUV(sourceCoord, _SSGISourceSize);
    float2 prevScreenUV = screenUV - motionVector;
    float3 previousData = 0.0;
    float4 previousMomentsRaw = 0.0;
    bool historyValid = false;
    if (_GITemporalAccumulation > 0.0 && _SSGIHistoryValid != 0 && _GIDenoiseHistoryValid != 0)
        historyValid = LoadReSTIRGIHistory(screenUV, prevScreenUV, curCoordData.depth,
            curCoordData.normal, previousData, previousMomentsRaw);

    // Missing rays are not black observations. Keep a geometrically valid
    // history briefly, then reconstruct from valid neighbors if available.
    if (!currentValid && historyValid && previousMomentsRaw.w < 4.0)
    {
        previousMomentsRaw.w += 1.0;
        _OutputGITextureRW[coordSS] = float4(previousData, 1.0);
        #if FINAL_PASS
        _OutputFinalGITextureRW[coordSS] = float4(previousData, 1.0);
        #endif
        _OutputMomentsTextureRW[coordSS] = previousMomentsRaw;
        return;
    }

    if (!currentValid && localNeighborhood.count > 0)
    {
        currentData = localNeighborhood.mean;
        currentValid = true;
        historyValid = false;
    }

    if (!currentValid)
    {
        _OutputGITextureRW[coordSS] = 0.0;
        #if FINAL_PASS
        _OutputFinalGITextureRW[coordSS] = 0.0;
        #endif
        _OutputMomentsTextureRW[coordSS] = 0.0;
        return;
    }

    // Match the SSR accumulator: the Volume setting controls the effective
    // history length, while 1 / sampleCount controls the current-frame weight.
    float maxSamplesNum = lerp(1.0, 32.0, saturate(_GITemporalAccumulation));
    if (!historyValid)
        previousMomentsRaw = 0.0;
    float prevSampleCount = previousMomentsRaw.z * maxSamplesNum;

    float oldMom = previousMomentsRaw.x;
    float oldVariance = previousMomentsRaw.y;
    float sampleCount = min(prevSampleCount + 1.0, maxSamplesNum);
    float currentLuma = Luminance(currentData);
    float currentWeight = rcp(max(sampleCount, 1.0));
    float historyWeight = 1.0 - currentWeight;
    float delta = currentLuma - oldMom;
    float newMom = oldMom + delta * currentWeight;
    float variance = sampleCount > 1.0
        ? historyWeight * (oldVariance + currentWeight * delta * delta) : 1.0;
    float4 currentMoments = float4(newMom, variance, sampleCount / maxSamplesNum, 0.0);

    if (localNeighborhood.count >= 3)
    {
        float3 nmin = localNeighborhood.mean - 3.0 * localNeighborhood.stdDev;
        float3 nmax = localNeighborhood.mean + 3.0 * localNeighborhood.stdDev;
        previousData = clamp(previousData, nmin, nmax);
    }

    float3 accumResult = historyValid ? lerp(previousData, currentData, currentWeight) : currentData;
    variance = max(variance, Luminance(localNeighborhood.variance));
    currentMoments.y = variance;

    _OutputGITextureRW[coordSS] = float4(accumResult, 1.0);
    #if FINAL_PASS
    _OutputFinalGITextureRW[coordSS] = float4(accumResult, 1.0);
    #endif
    _OutputMomentsTextureRW[coordSS] = currentMoments;
}

#ifndef GI_SPATIAL_STEP_SIZE
#define GI_SPATIAL_STEP_SIZE (1)
#endif
#define GI_SPATIAL_HALO_WIDTH (GI_SPATIAL_STEP_SIZE)
#define GI_SPATIAL_SHARED_WIDTH (8 + 2 * GI_SPATIAL_HALO_WIDTH)

groupshared float4 localNormalDepth[GI_SPATIAL_SHARED_WIDTH * GI_SPATIAL_SHARED_WIDTH];
groupshared float4 localColorVariance[GI_SPATIAL_SHARED_WIDTH * GI_SPATIAL_SHARED_WIDTH];
groupshared float localValidity[GI_SPATIAL_SHARED_WIDTH * GI_SPATIAL_SHARED_WIDTH];

struct SpatialCoordData
{
    float3 normal;
    float depth;
    float3 color;
    float variance;
    float valid;
};

SpatialCoordData LoadFromGroupSharedMemory(uint2 gThreadId)
{
    uint localID = gThreadId.x + GI_SPATIAL_SHARED_WIDTH * gThreadId.y;
    float4 encodedNormalDepth = localNormalDepth[localID];
    float4 encodedColorVariance = localColorVariance[localID];

    SpatialCoordData sample;
    ZERO_INITIALIZE(SpatialCoordData, sample);
    sample.normal = encodedNormalDepth.xyz;
    sample.depth = encodedNormalDepth.w;
    sample.color = encodedColorVariance.xyz;
    sample.variance = encodedColorVariance.w;
    sample.valid = localValidity[localID];
    return sample;
}

void StoreInGroupSharedMemory(uint2 gThreadId, SpatialCoordData inData)
{
    uint localID = gThreadId.x + GI_SPATIAL_SHARED_WIDTH * gThreadId.y;
    localNormalDepth[localID] = float4(inData.normal, inData.depth);
    localColorVariance[localID] = float4(inData.color, inData.variance);
    localValidity[localID] = inData.valid;
}

void LoadCoordData(int2 coordSS, out SpatialCoordData outData)
{
    ZERO_INITIALIZE(SpatialCoordData, outData);
    if (coordSS.x >= _SSGITraceScreenSize.x || coordSS.y >= _SSGITraceScreenSize.y || coordSS.x < 0 || coordSS.y < 0)
    {
        outData.depth = UNITY_RAW_FAR_CLIP_VALUE;
        return;
    }

    uint2 sourceCoord = GetReSTIRGISourceCoord((uint2)coordSS);
    float deviceDepth = LoadSceneDepth(sourceCoord);
    if (deviceDepth == UNITY_RAW_FAR_CLIP_VALUE)
    {
        outData.depth = UNITY_RAW_FAR_CLIP_VALUE;
        return;
    }

    outData.normal = LoadNormalWS((uint2)coordSS);
    outData.depth = LinearEyeDepth(deviceDepth, _ZBufferParams);
    float4 gi = LOAD_TEXTURE2D_X(_InputGITexture, coordSS);
    outData.color = gi.rgb;
    outData.valid = gi.a;
    outData.variance = LOAD_TEXTURE2D_X(_InputMomentsTexture, coordSS).y;
}

void InitializeGroupSharedMemory(int2 dThreadId, uint2 gThreadId)
{
    dThreadId -= GI_SPATIAL_HALO_WIDTH;

    // Each kernel only loads the halo needed by its A-Trous step.
    for (int tileY = 0; tileY < 2; ++tileY)
    {
        for (int tileX = 0; tileX < 2; ++tileX)
        {
            int2 offset = int2(tileX, tileY) * 8;
            if (any(int2(gThreadId) + offset >= GI_SPATIAL_SHARED_WIDTH))
                continue;
            SpatialCoordData coordData;
            LoadCoordData(dThreadId + offset, coordData);
            StoreInGroupSharedMemory(gThreadId + (uint2)offset, coordData);
        }
    }
}

float GetVarianceFromGroupSharedMemory(int2 coordGroup)
{
    float variance = 0.0;
    float weightSum = 0.0;
    float kernel[2][2] =
    {
        { 1.0 / 4.0, 1.0 / 8.0 },
        { 1.0 / 8.0, 1.0 / 16.0 }
    };

    for (int y = -1; y <= 1; ++y)
    {
        for (int x = -1; x <= 1; ++x)
        {
            SpatialCoordData data = LoadFromGroupSharedMemory((uint2)(coordGroup + int2(x, y)));
            if (data.valid <= 0.0)
                continue;
            float weight = kernel[abs(x)][abs(y)];
            variance += data.variance * weight;
            weightSum += weight;
        }
    }

    return variance / max(weightSum, 1e-6);
}

float ComputeEdgeStoppingWeight(SpatialCoordData center, SpatialCoordData neigh, float stdDev)
{
    if (neigh.valid <= 0.0 || neigh.depth == UNITY_RAW_FAR_CLIP_VALUE)
        return 0.0;

    float depthDiff = abs(center.depth - neigh.depth);
    float normalDiff = saturate(dot(center.normal, neigh.normal));
    if (depthDiff > max(_SSGIDepthTolerance * max(center.depth, 1.0), 1e-4)
        || normalDiff < _SSGINormalTolerance)
        return 0.0;
    float colorDiff = abs(Luminance(center.color) - Luminance(neigh.color));

    float depthWeight = exp(-depthDiff * 3.0);
    float normalWeight = pow(normalDiff, 32.0);
    float varianceWeight = center.valid > 0.0
        ? exp(-colorDiff / max(stdDev, 1e-3)) : 1.0;
    return depthWeight * normalWeight * varianceWeight;
}

void ApplySpatialStep(uint2 coordGroup, SpatialCoordData centerData,
    float centerStdDeviation, out float3 outColor, out float outValid)
{
    const float kernel[2] = { 1.0, 2.0 / 3.0 };

    float weightSum = saturate(centerData.valid);
    float3 colorSum = centerData.color * weightSum;
    for (int y = -1; y <= 1; ++y)
    {
        for (int x = -1; x <= 1; ++x)
        {
            if (x == 0 && y == 0)
            continue;

            int2 step = int2(x, y) * GI_SPATIAL_STEP_SIZE;
            int2 coordGroupOffseted = clamp(int2(coordGroup) + step, int2(0, 0), int2(GI_SPATIAL_SHARED_WIDTH - 1, GI_SPATIAL_SHARED_WIDTH - 1));
            SpatialCoordData neighData = LoadFromGroupSharedMemory((uint2)coordGroupOffseted);

            float weight = ComputeEdgeStoppingWeight(centerData, neighData, centerStdDeviation);
            weight *= kernel[abs(x)] * kernel[abs(y)];

            colorSum += weight * neighData.color;
            weightSum += weight;
        }
    }

    outColor = weightSum > 1e-5 ? colorSum / weightSum : 0.0;
    outValid = weightSum > 1e-5 ? 1.0 : 0.0;
}

[numthreads(8, 8, 1)]
void DENOISE_SPATIAL(uint3 dispatchThreadID : SV_DispatchThreadID, uint2 groupThreadID : SV_GroupThreadID)
{
    uint2 coordSS = dispatchThreadID.xy;
    bool validPixel = IsValidPixel(coordSS);

    uint2 coordGroup = groupThreadID.xy;
    InitializeGroupSharedMemory(int2(coordSS), coordGroup);
    GroupMemoryBarrierWithGroupSync();

    coordGroup += GI_SPATIAL_HALO_WIDTH;
    SpatialCoordData centerData = LoadFromGroupSharedMemory(coordGroup);
    bool validCenter = validPixel && centerData.depth != UNITY_RAW_FAR_CLIP_VALUE;

    float variance = validCenter ? GetVarianceFromGroupSharedMemory((int2)coordGroup) : 0.0;
    float centerStdDeviation = sqrt(max(variance + 1e-9, 0.0));

    float3 spatialResult = 0.0;
    float spatialValid = 0.0;
    if (validCenter)
        ApplySpatialStep(coordGroup, centerData,
            centerStdDeviation, spatialResult, spatialValid);

    if (validPixel)
        _OutputGITextureRW[coordSS] = float4(spatialResult, spatialValid);
}
