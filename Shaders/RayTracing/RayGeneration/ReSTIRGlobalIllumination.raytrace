// ReSTIR GI initial candidate generation. Temporal/spatial reuse and resolve
// intentionally run in the companion compute shader, matching the old pipeline.
#pragma max_recursion_depth 1
#define SHADER_TARGET 50

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Sampling/Sampling.hlsl"
#include "Packages/com.unity.render-pipelines.danbaidong/ShaderLibrary/Core.hlsl"
#include "Packages/com.unity.render-pipelines.danbaidong/ShaderLibrary/DeclareDepthTexture.hlsl"
#include "Packages/com.unity.render-pipelines.danbaidong/ShaderLibrary/BlueNoise.hlsl"
#include "Packages/com.unity.render-pipelines.danbaidong/ShaderLibrary/UnityGBuffer.hlsl"
#include "Packages/com.unity.render-pipelines.danbaidong/Shaders/ScreenSpaceLighting/ReSTIRGIReservoir.hlsl"
#include "Packages/com.unity.render-pipelines.danbaidong/Shaders/ScreenSpaceLighting/ReSTIRGIRandom.hlsl"
#include "Packages/com.unity.render-pipelines.danbaidong/Shaders/ScreenSpaceLighting/ReSTIRGIDirections.hlsl"

#include "Packages/com.unity.render-pipelines.danbaidong/Shaders/Raytracing/ShaderVariablesRaytracing.hlsl"
#include "Packages/com.unity.render-pipelines.danbaidong/Shaders/Raytracing/RayTracingCommon.hlsl"
#include "Packages/com.unity.render-pipelines.danbaidong/Shaders/Raytracing/RaytracingIntersection.hlsl"
#include "Packages/com.unity.render-pipelines.danbaidong/Runtime/Raytracing/RayTracingFallbackHierarchy.cs.hlsl"
#include "Packages/com.unity.render-pipelines.danbaidong/Runtime/ScreenSpaceLighting/ShaderVariablesScreenSpaceGlobalIllumination.cs.hlsl"
#include "Packages/com.unity.render-pipelines.danbaidong/Shaders/ScreenSpaceLighting/ReSTIRGICoordinates.hlsl"

TEXTURE2D_X(_GBuffer2);

RW_TEXTURE2D(uint4, _OutputReservoirData0RW);
RW_TEXTURE2D(uint4, _OutputReservoirData1RW);
RW_TEXTURE2D(uint4, _OutputReservoirData2RW);

ReSTIRGISurface LoadSurface(uint2 traceCoord)
{
    ReSTIRGISurface surface = (ReSTIRGISurface)0;
    uint2 sourceCoord = GetReSTIRGISourceCoord(traceCoord);
    float rawDepth = LoadSceneDepth(sourceCoord);
    if (rawDepth == UNITY_RAW_FAR_CLIP_VALUE)
        return surface;

    float4 gbuffer2 = LOAD_TEXTURE2D_X(_GBuffer2, sourceCoord);
    PositionInputs posInput = GetPositionInput(sourceCoord, _SSGISourceSize.zw, rawDepth, UNITY_MATRIX_I_VP, GetWorldToViewMatrix(), 0);
    surface.positionWS = posInput.positionWS;
    surface.normalWS = normalize(UnpackNormal(gbuffer2.xyz));
    return surface;
}

bool IsValidSurface(ReSTIRGISurface surface)
{
    return any(surface.normalWS != 0.0);
}

void StoreOutputReservoir(uint2 pixel, GIReservoir reservoir)
{
    PackedGIReservoir packed = PackGIReservoir(reservoir);
    _OutputReservoirData0RW[pixel] = packed.creationGeometry;
    _OutputReservoirData1RW[pixel] = packed.hitGeometry;
    _OutputReservoirData2RW[pixel] = packed.lightInfo;
}

[shader("miss")]
void MissShaderGlobalIllumination(inout RayIntersection rayIntersection : SV_RayPayload)
{
    float3 rayDirection = WorldRayDirection();
    rayIntersection.packedNormalWS = PackNormalOctQuadEncode(-rayDirection);

    // reflectionProbes

    float weight = 0.0;
    if ((RAYTRACINGFALLBACKHIERACHY_SKY & _RayTracingRayMissFallbackHierarchy) && weight < 1.0)
    {
        rayIntersection.color += SAMPLE_TEXTURECUBE_LOD(
            _SkyTexture, sampler_TrilinearClamp, rayDirection, 0.0).xyz;
        weight = 1.0;
    }

    // fo

    rayIntersection.t = _RaytracingRayMaxLength;
}

[shader("raygeneration")]
void SingleRayGen()
{
    uint2 traceCoord = DispatchRaysIndex().xy;
    uint2 sourceCoord = GetReSTIRGISourceCoord(traceCoord);
    ReSTIRGISurface surface = LoadSurface(traceCoord);
    if (!IsValidSurface(surface))
    {
        StoreOutputReservoir(traceCoord, CreateEmptyGIReservoir());
        return;
    }

    float rayBias = EvaluateRayTracingBias(surface.positionWS);
    float3x3 localToWorld = GetLocalFrame(surface.normalWS);
    uint candidateCount = clamp((uint)_SSGICandidateCount, 1u, 8u);
    uint selectionRandom = InitReSTIRGIRandom(sourceCoord, (uint)_SSGIFrameIndex, RESTIR_GI_RANDOM_INITIAL);

    GIReservoir selectedReservoir = CreateEmptyGIReservoir();
    selectedReservoir.creationPoint = surface.positionWS;
    selectedReservoir.creationNormal = surface.normalWS;
    float weightSum = 0.0;

    UNITY_LOOP
    for (uint candidateIndex = 0; candidateIndex < candidateCount; ++candidateIndex)
    {
        float3 localDirection = SampleReSTIRGICosineDirection(sourceCoord, (uint)_SSGIFrameIndex, candidateIndex);
        float3 rayDirection = normalize(mul(localDirection, localToWorld));
        float sampleCosine = saturate(dot(surface.normalWS, rayDirection));
        float samplePdf = sampleCosine / PI;
        if (samplePdf <= 1e-6)
            continue;

        RayDesc rayDescriptor;
        rayDescriptor.Origin = surface.positionWS + surface.normalWS * rayBias;
        rayDescriptor.Direction = rayDirection;
        rayDescriptor.TMin = 0.0;
        rayDescriptor.TMax = _RaytracingRayMaxLength;

        RayIntersection rayIntersection = (RayIntersection)0;
        rayIntersection.t = -1.0;
        rayIntersection.remainingDepth = 1;
        rayIntersection.sampleIndex = (uint)candidateIndex;
        rayIntersection.pixelCoord = sourceCoord;
        rayIntersection.packedNormalWS = PackNormalOctQuadEncode(-rayDirection);

        TraceRay(_RaytracingAccelerationStructure, RAY_FLAG_CULL_BACK_FACING_TRIANGLES,
            RAYTRACINGRENDERERFLAG_GLOBAL_ILLUMINATION, 0, 1, 0, rayDescriptor, rayIntersection);

        GIReservoir candidateReservoir = CreateEmptyGIReservoir();
        candidateReservoir.creationPoint = surface.positionWS;
        candidateReservoir.creationNormal = surface.normalWS;
        candidateReservoir.position = rayDescriptor.Origin + rayDirection * max(rayIntersection.t, 0.0);
        candidateReservoir.normal = normalize(UnpackNormalOctQuadEncode(rayIntersection.packedNormalWS));
        if (dot(candidateReservoir.normal, candidateReservoir.creationPoint - candidateReservoir.position) < 0.0)
            candidateReservoir.normal *= -1.0;
        if (dot(candidateReservoir.creationNormal, candidateReservoir.position - candidateReservoir.creationPoint) < 0.0)
            candidateReservoir.creationNormal *= -1.0;
        candidateReservoir.radiance = min(max(rayIntersection.color, 0.0), _RaytracingIntensityClamp.xxx);
        candidateReservoir.M = 1;
        candidateReservoir.avgWeight = rcp(samplePdf);
        candidateReservoir.age = 0u;

        float targetPdf = evalTargetFunction(candidateReservoir.radiance, surface.normalWS, surface.positionWS, candidateReservoir.position);
        updateReservoir(targetPdf * rcp(samplePdf), candidateReservoir, NextReSTIRGIRandom(selectionRandom), weightSum, selectedReservoir);
    }

    if (selectedReservoir.M > 0)
    {
        float avgWeightSum = weightSum / max((float)selectedReservoir.M, 1.0);
        float selectedTargetPdf = evalTargetFunction(selectedReservoir.radiance, selectedReservoir.creationNormal,
            selectedReservoir.creationPoint, selectedReservoir.position);
        selectedReservoir.avgWeight = selectedTargetPdf > 0.0 ? avgWeightSum / selectedTargetPdf : 0.0;
        selectedReservoir.creationPoint = surface.positionWS;
        selectedReservoir.creationNormal = surface.normalWS;
    }
    else
    {
        selectedReservoir = CreateEmptyGIReservoir();
    }

    StoreOutputReservoir(traceCoord, selectedReservoir);
}
